{
  "version": 2,
  "builds": [
    {
      "src": "plant-disease-scanner/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "plant-disease-scanner/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "plant-disease-scanner/server.js"
    }
  ]
}